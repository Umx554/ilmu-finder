# Copy this file to .env for local testing. NEVER commit .env.
TAVILY_API_KEY=tvly-xxxxxxxx
LLM_API_KEY=gsk_xxxxxxxx
TELEGRAM_TOKEN=123456:ABC-xxxxxxxx
TELEGRAM_CHAT_ID=123456789

# Optional: also (or only) receive the digest by e-mail. For Gmail, create an
# App Password (Google Account > Security > 2-Step Verification > App passwords).
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# EMAIL_TO=you@gmail.com
# Not Gmail? Set your provider's SSL server (on your computer only; the GitHub workflow always uses Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optional overrides for runs on your computer (otherwise taken from config.yaml).
# The GitHub workflow does not use these: edit config.yaml for the weekly run.
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_FALLBACK_MODEL=llama-3.1-8b-instant
# LLM_BASE_URL=https://api.groq.com/openai/v1
# MAX_PAGES=5
# MAX_QUERIES=5
# LLM_DELAY=8
# MAX_CHARS_PER_PAGE=6000
# TODAY=2026-11-23     # pretend today is this date (testing)
